# Copy to .env and fill in. Only ANTHROPIC_API_KEY is required (for LLM intake).
# The key stays server-side and is never exposed to the frontend.
ANTHROPIC_API_KEY=

# --- Optional: directions provider for real transit/walking commute times ---
# Default provider is OSRM (no key, driving only). To use transit/walking, set
# directions_provider to google/mapbox/ors in Settings and provide the key here.
# GOOGLE_MAPS_API_KEY=
# MAPBOX_TOKEN=
# ORS_API_KEY=

# --- Optional: in-app data refresh (operator-only) ---
# The Refresh button and POST /refresh run the incremental collect -> enrich ->
# dedupe -> autoscore cycle on this machine (no LLM / API key needed; run on a VPN
# so Craigslist doesn't IP-block the fetches). Enabled by default for local use.
# Set to 0 to disable if you ever expose this backend to other people — the public
# static deploy has no backend, so it is never affected.
# ROOST_ALLOW_REFRESH=1

# --- Optional overrides ---
# ROOST_DATA_DIR=./data
# ROOST_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
