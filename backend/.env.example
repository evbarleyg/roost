# Copy to .env and fill in. Only ANTHROPIC_API_KEY is required (for LLM intake).
# The key stays server-side and is never exposed to the frontend.
ANTHROPIC_API_KEY=

# --- Optional: directions provider for real transit/walking commute times ---
# Default provider is OSRM (no key, driving only). To use transit/walking, set
# directions_provider to google/mapbox/ors in Settings and provide the key here.
# GOOGLE_MAPS_API_KEY=
# MAPBOX_TOKEN=
# ORS_API_KEY=

# --- Optional overrides ---
# ROOST_DATA_DIR=./data
# ROOST_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
